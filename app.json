{
  "expo": {
    "name": "Joachrono",
    "slug": "joachrono",
    "scheme": "joachrono",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      "expo-audio",
      "expo-asset",
      "expo-sqlite",
      "expo-notifications",
      [
        "expo-localization",
        { "supportedLocales": { "ios": ["pt", "en"], "android": ["pt", "en"] } }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.joachrono"
    },
    "android": {
      "package": "app.joachrono",
      "permissions": ["SCHEDULE_EXACT_ALARM"],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "joaquimfsneto",
    "extra": {
      "eas": {
        "projectId": "a0ab4675-996a-4d1c-9eb7-7078c080a6cd"
      }
    }
  }
}
